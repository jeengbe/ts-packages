{
  "name": "@jeengbe/cache",
  "version": "7.0.6",
  "description": "A strongly typed TypeScript caching framework that works with any engine, with in-memory and Redis adapters included.",
  "keywords": [
    "cache",
    "caching",
    "framework",
    "in-memory",
    "ioredis",
    "redis",
    "ttl",
    "typed",
    "typescript"
  ],
  "homepage": "https://github.com/jeengbe/ts-packages/tree/master/packages/cache#readme",
  "bugs": {
    "url": "https://github.com/jeengbe/ts-packages/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jesper Engberg",
    "email": "jeengbe@gmail.com",
    "url": "https://github.com/jeengbe"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeengbe/ts-packages.git",
    "directory": "packages/cache"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/__snapshots__/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "typings": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix . && oxfmt --write .",
    "test": "vitest"
  },
  "dependencies": {
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@jeengbe/scaffolding": "workspace:*",
    "@testcontainers/redis": "^11.5.1",
    "@types/micromatch": "^4.0.9",
    "@types/ms": "^2.1.0",
    "ioredis": "^5.7.0",
    "micromatch": "^4.0.8",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "ioredis": "^5.3.2",
    "micromatch": "^4.0.8"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "micromatch": {
      "optional": true
    }
  }
}
