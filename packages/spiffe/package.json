{
  "name": "@jeengbe/spiffe",
  "version": "1.1.1",
  "description": "SPIFFE Workload API client for Node.js, Deno, and Bun. Fetch and validate JWT-SVIDs from SPIRE, with caching and retries.",
  "keywords": [
    "authentication",
    "spiffe",
    "spire",
    "svid",
    "jwt-svid",
    "jwt",
    "workload-api",
    "workload-identity",
    "workload-identity-federation",
    "zero-trust",
    "identity",
    "node",
    "nodejs",
    "javascript",
    "typescript",
    "deno",
    "bun",
    "kafka",
    "kafkajs",
    "confluent"
  ],
  "homepage": "https://github.com/jeengbe/ts-packages/tree/master/packages/spiffe#readme",
  "bugs": {
    "url": "https://github.com/jeengbe/ts-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeengbe/ts-packages.git",
    "directory": "packages/spiffe"
  },
  "license": "MIT",
  "author": {
    "name": "Jesper Engberg",
    "email": "jeengbe@gmail.com",
    "url": "https://github.com/jeengbe"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./kafkajs": {
      "types": "./dist/kafkajs.d.mts",
      "default": "./dist/kafkajs.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "typings": "./dist/index.d.mts",
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/__snapshots__/*",
    "!src/**/fake.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "generate:proto": "buf generate",
    "lint": "oxlint --fix . && oxfmt --write .",
    "test": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@grpc/grpc-js": "^1.14.3",
    "@isaacs/ttlcache": "^2.1.4",
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@jeengbe/scaffolding": "workspace:*",
    "kafkajs": "^2.2.4",
    "mappersmith": "^2.47.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "kafkajs": "^2.2.4",
    "mappersmith": "^2.47.0"
  },
  "peerDependenciesMeta": {
    "kafkajs": {
      "optional": true
    },
    "mappersmith": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
