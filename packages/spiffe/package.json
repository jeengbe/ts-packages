{
  "name": "@jeengbe/spiffe",
  "version": "0.6.0",
  "description": "A TypeScript library for working with SPIFFE workload identities.",
  "keywords": [
    "JWT",
    "SPIFFE",
    "SPIRE",
    "SVID",
    "Workload Identity",
    "X.509"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeengbe/ts-packages.git",
    "directory": "packages/spiffe"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./google-auth": {
      "types": "./dist/google-auth.d.mts",
      "default": "./dist/google-auth.mjs"
    },
    "./kafkajs": {
      "types": "./dist/kafkajs.d.mts",
      "default": "./dist/kafkajs.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "generate:proto": "buf generate",
    "lint": "oxlint --fix . && oxfmt --write .",
    "test": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@grpc/grpc-js": "^1.14.3",
    "@isaacs/ttlcache": "^2.1.4"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@jeengbe/scaffolding": "workspace:*",
    "google-auth-library": "^10.9.0",
    "kafkajs": "^2.2.4",
    "mappersmith": "^2.47.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "google-auth-library": "^10.9.0",
    "kafkajs": "^2.2.4",
    "mappersmith": "^2.47.0"
  },
  "peerDependenciesMeta": {
    "google-auth-library": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    },
    "mappersmith": {
      "optional": true
    }
  }
}
