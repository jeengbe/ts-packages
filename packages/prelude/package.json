{
  "name": "@jeengbe/prelude",
  "version": "0.1.3",
  "description": "A small, dependency-free functional programming toolkit for TypeScript.",
  "keywords": [
    "either",
    "fp",
    "functional-programming",
    "maybe",
    "monad",
    "option",
    "result",
    "typescript"
  ],
  "homepage": "https://github.com/jeengbe/ts-packages/tree/master/packages/prelude#readme",
  "bugs": {
    "url": "https://github.com/jeengbe/ts-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeengbe/ts-packages.git",
    "directory": "packages/prelude"
  },
  "license": "MIT",
  "author": {
    "name": "Jesper Engberg",
    "email": "jeengbe@gmail.com",
    "url": "https://github.com/jeengbe"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "typings": "./dist/index.d.mts",
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/__snapshots__/*",
    "!src/**/fake.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix . && oxfmt --write .",
    "test": "vitest"
  },
  "devDependencies": {
    "@jeengbe/scaffolding": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
