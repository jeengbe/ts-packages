{
  "name": "@jeengbe/config",
  "version": "0.0.6",
  "description": "A declarative, strongly typed schema for parsing and validating environment variables in TypeScript.",
  "keywords": [
    "config",
    "configuration",
    "env",
    "environment-variables",
    "schema",
    "typed",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/jeengbe/ts-packages/tree/master/packages/config#readme",
  "bugs": {
    "url": "https://github.com/jeengbe/ts-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeengbe/ts-packages.git",
    "directory": "packages/config"
  },
  "license": "MIT",
  "author": {
    "name": "Jesper Engberg",
    "email": "jeengbe@gmail.com",
    "url": "https://github.com/jeengbe"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "typings": "./dist/index.d.mts",
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/__snapshots__/*",
    "!src/**/fake.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix . && oxfmt --write .",
    "test": "vitest"
  },
  "dependencies": {
    "@jeengbe/prelude": "workspace:*"
  },
  "devDependencies": {
    "@jeengbe/scaffolding": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
