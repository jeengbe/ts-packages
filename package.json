{
  "name": "ts-env",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "changeset": "changeset",
    "docs:packages": "node scripts/generate-readme-packages.ts && oxfmt --write README.md",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:readonly": "oxlint . && oxfmt --check .",
    "release": "pnpm run build && changeset publish",
    "test": "pnpm -r run test",
    "test:coverage": "vitest run --coverage",
    "version": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@jeengbe/scaffolding": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "jsr": "^0.14.3",
    "lefthook": "^2.1.10",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.22",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  }
}
